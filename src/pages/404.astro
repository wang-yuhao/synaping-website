---
import Base from '../layouts/Base.astro';
---
<Base locale="zh" slug="404/" title="页面未找到 | Page not found" description="404" alternates={[]} noindex>
  <section class="mx-auto max-w-3xl px-5 py-32 text-center">
    <p class="font-[family-name:var(--font-display)] text-7xl font-semibold text-gradient">404</p>
    <h1 class="mt-6 text-2xl text-white">页面未找到 · Page not found · Seite nicht gefunden</h1>
    <div class="mt-8 flex justify-center gap-3 flex-wrap"><a href="/" class="btn-primary">首页</a><a href="/en/" class="btn-ghost">Home</a><a href="/de/" class="btn-ghost">Startseite</a></div>
  </section>
</Base>
