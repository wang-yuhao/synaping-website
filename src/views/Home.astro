---
import Icon from '../components/Icon.astro';
import { home, services, cases, labs } from '../content/site';
import { localePath, ui, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const h = home[locale];
const t = ui[locale];
const L = (o: any) => o[locale] ?? o.en;
const full = locale !== 'de';
const stack = ['Databricks', 'Apache Spark', 'Delta Lake', 'Python', 'TypeScript', 'Astro', 'Azure', 'AWS', 'JD Cloud', 'Docker', 'Nginx', 'GitHub Actions', 'Power BI', 'LangGraph'];
---
<section class="relative overflow-hidden glow">
  <canvas id="hero-net" class="absolute inset-0 w-full h-full opacity-70" aria-hidden="true"></canvas>
  <div class="absolute inset-0 grid-bg [mask-image:radial-gradient(ellipse_at_center,black,transparent_75%)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-5 pt-24 pb-28 md:pt-32 md:pb-36">
    <p class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/5 px-3 py-1 text-xs text-cyan-200 tracking-wide">
      <span class="h-1.5 w-1.5 rounded-full bg-cyan-300 animate-pulse"></span>{h.eyebrow}
    </p>
    <h1 class="mt-6 text-4xl sm:text-5xl md:text-6xl font-semibold leading-tight text-white max-w-4xl">
      {h.h1a}<br /><span class="text-gradient">{h.h1b}</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-300 leading-relaxed">{h.lead}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={localePath(locale, 'contact/')} class="btn-primary">{t.cta}<Icon name="arrow" class="w-4 h-4" /></a>
      <a href={localePath(locale, 'services/')} class="btn-ghost">{h.secondary}</a>
    </div>
    <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-2 text-sm text-slate-400">
      {h.trust.map((x) => <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-cyan-300" />{x}</li>)}
    </ul>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-20">
  <h2 class="text-3xl font-semibold text-white">{h.servicesTitle}</h2>
  <p class="mt-3 text-slate-400 max-w-2xl">{h.servicesLead}</p>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {services.map((s) => (
      <a href={localePath(locale, full ? `services/${s.slug}/` : 'services/')} class="card p-7 transition-colors group block">
        <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-400/20 to-violet-500/20 text-cyan-200"><Icon name={s.icon} /></span>
        <h3 class="mt-5 text-xl font-semibold text-white">{L(s.title)}</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">{L(s.short)}</p>
        <span class="mt-5 inline-flex items-center gap-1 text-sm text-cyan-300 group-hover:gap-2 transition-all">{t.learnMore}<Icon name="arrow" class="w-4 h-4" /></span>
      </a>
    ))}
  </div>
</section>

<section class="mx-auto max-w-7xl px-5">
  <div class="card p-8 md:p-12 relative overflow-hidden">
    <div class="absolute -right-24 -top-24 w-72 h-72 rounded-full bg-violet-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative grid md:grid-cols-[1fr_auto] gap-8 items-center">
      <div>
        <p class="text-xs tracking-[0.3em] text-amber-300/90 uppercase">Shanghai ⇄ München</p>
        <h2 class="mt-3 text-3xl font-semibold text-white">{h.kitTitle}</h2>
        <p class="mt-3 text-slate-300 max-w-2xl leading-relaxed">{h.kitLead}</p>
      </div>
      <a href={localePath(locale, full ? 'solutions/eu-launch-kit/' : 'contact/')} class="btn-primary justify-self-start">{t.learnMore}<Icon name="arrow" class="w-4 h-4" /></a>
    </div>
  </div>
</section>

{full && (
<section class="mx-auto max-w-7xl px-5 py-20">
  <h2 class="text-3xl font-semibold text-white">{h.casesTitle}</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {cases.map((c) => (
      <a href={localePath(locale, `cases/${c.slug}/`)} class="card p-7 block transition-colors">
        <div class="flex gap-2">{c.tags.map((tg) => <span class="text-[11px] rounded-full border border-slate-600 px-2 py-0.5 text-slate-300">{tg}</span>)}</div>
        <h3 class="mt-4 text-lg font-semibold text-white leading-snug">{L(c.title)}</h3>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">{L(c.summary)}</p>
      </a>
    ))}
  </div>
</section>
)}

<section class="mx-auto max-w-7xl px-5 py-20">
  <h2 class="text-3xl font-semibold text-white">{h.processTitle}</h2>
  <ol class="mt-10 grid gap-6 md:grid-cols-4">
    {h.process.map((p, i) => (
      <li class="relative card p-6">
        <span class="font-[family-name:var(--font-display)] text-4xl font-semibold text-gradient">0{i + 1}</span>
        <h3 class="mt-3 text-lg font-semibold text-white">{p.t}</h3>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">{p.d}</p>
      </li>
    ))}
  </ol>
</section>

{full && (
<section class="mx-auto max-w-7xl px-5 pb-20">
  <div class="flex items-end justify-between gap-6">
    <div><h2 class="text-3xl font-semibold text-white">{h.labsTitle}</h2><p class="mt-3 text-slate-400">{h.labsLead}</p></div>
    <a href={localePath(locale, 'labs/')} class="hidden sm:inline-flex text-sm text-cyan-300 items-center gap-1">{t.learnMore}<Icon name="arrow" class="w-4 h-4" /></a>
  </div>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {labs.map((l) => (
      <a href={localePath(locale, `labs/${l.slug}/`)} class="card p-7 flex gap-5 items-start transition-colors">
        <span class="shrink-0 inline-grid place-items-center w-11 h-11 rounded-xl bg-violet-500/15 text-violet-200"><Icon name="lab" /></span>
        <span><span class="block text-lg font-semibold text-white">{L(l.title)}</span><span class="block mt-2 text-sm text-slate-400">{L(l.summary)}</span></span>
      </a>
    ))}
  </div>
</section>
)}

<section class="border-y border-white/5 py-10 overflow-hidden">
  <p class="text-center text-xs tracking-[0.3em] text-slate-500 uppercase">{h.stackTitle}</p>
  <ul class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-3 px-5 text-slate-400 font-[family-name:var(--font-display)]">
    {stack.map((s) => <li>{s}</li>)}
  </ul>
</section>

<section class="mx-auto max-w-4xl px-5 pt-20 text-center">
  <h2 class="text-3xl md:text-4xl font-semibold text-white">{t.cta}</h2>
  <a href={localePath(locale, 'contact/')} class="mt-8 btn-primary">{t.ctaShort}<Icon name="arrow" class="w-4 h-4" /></a>
</section>

<script>
  import { initHero } from '../scripts/hero';
  const c = document.getElementById('hero-net') as HTMLCanvasElement | null;
  if (c) initHero(c);
</script>
