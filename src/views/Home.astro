---
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Terminal from '../components/Terminal.astro';
import BridgeLine from '../components/BridgeLine.astro';
import { home, services, cases, labs, pipeline, stackLayers, engagement } from '../content/site';
import { localePath, ui, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const h = home[locale];
const t = ui[locale];
const L = (o: any) => o[locale] ?? o.en;
const full = locale !== 'de';
const e = engagement[locale];
---
<section class="relative overflow-hidden glow">
  <canvas id="hero-net" class="absolute inset-0 w-full h-full opacity-70" aria-hidden="true"></canvas>
  <div class="absolute inset-0 grid-bg [mask-image:radial-gradient(ellipse_at_center,black,transparent_75%)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-5 pt-20 pb-24 md:pt-28 md:pb-32 grid gap-14 lg:grid-cols-[1.15fr_1fr] items-center">
    <div class="min-w-0">
      <p class="inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/5 px-3 py-1 text-xs text-cyan-200 tracking-wide">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan-300 animate-pulse"></span>{h.eyebrow}
      </p>
      <h1 class="mt-6 text-4xl sm:text-5xl md:text-6xl font-semibold leading-tight text-white">
        {h.h1a}<br /><span class="text-gradient">{h.h1b}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-300 leading-relaxed">{h.lead}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={localePath(locale, 'contact/')} class="btn-primary">{t.cta}<Icon name="arrow" class="w-4 h-4" /></a>
        <a href={localePath(locale, 'services/')} class="btn-ghost">{h.secondary}</a>
      </div>
      <ul class="mt-12 flex flex-wrap gap-x-8 gap-y-2 text-sm text-slate-400">
        {h.trust.map((x) => <li class="flex items-center gap-2"><Icon name="check" class="w-4 h-4 text-cyan-300" />{x}</li>)}
      </ul>
    </div>
    <figure class="min-w-0">
      <Terminal title={h.terminalTitle} lines={pipeline as any} />
      <figcaption class="mt-3 text-xs text-slate-400">{h.terminalCap}</figcaption>
    </figure>
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 py-20">
  <SectionHead kicker="01 · Services" title={h.servicesTitle} lead={h.servicesLead} />
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {services.map((s, i) => (
      <a href={localePath(locale, full ? `services/${s.slug}/` : 'services/')} class="card card-glow p-7 transition-colors group flex flex-col">
        <div class="flex items-center justify-between">
          <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-400/20 to-violet-500/20 text-cyan-200"><Icon name={s.icon} /></span>
          <span class="font-mono-ui text-xs text-slate-500">0{i + 1}</span>
        </div>
        <h3 class="mt-5 text-xl font-semibold text-white">{L(s.title)}</h3>
        <p class="mt-3 text-slate-400 leading-relaxed">{L(s.short)}</p>
        <ul class="mt-5 flex flex-wrap gap-1.5">{s.stack.slice(0, 4).map((x) => <li class="chip !text-[11px]">{x}</li>)}</ul>
        <span class="mt-auto pt-6 inline-flex items-center gap-1 text-sm text-cyan-300 group-hover:gap-2 transition-all">{t.learnMore}<Icon name="arrow" class="w-4 h-4" /></span>
      </a>
    ))}
  </div>
</section>

<section class="mx-auto max-w-7xl px-5 pb-20">
  <SectionHead kicker={`02 · ${h.whyKicker}`} title={h.whyTitle} />
  <div class="mt-10 grid gap-px rounded-2xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-line)] sm:grid-cols-2 lg:grid-cols-4">
    {h.why.map((w) => (
      <div class="bg-[#0b1220] p-7">
        <Icon name={w.icon as any} class="w-7 h-7 text-cyan-300" />
        <h3 class="mt-4 text-lg font-semibold text-white">{w.t}</h3>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">{w.d}</p>
      </div>
    ))}
  </div>
</section>

<section class="mx-auto max-w-7xl px-5">
  <div class="card p-8 md:p-12 relative overflow-hidden">
    <div class="absolute -right-24 -top-24 w-72 h-72 rounded-full bg-violet-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative grid lg:grid-cols-[1.2fr_1fr] gap-10 items-center">
      <div>
        <p class="text-xs tracking-[0.3em] text-amber-300/90 uppercase">Shanghai ⇄ München</p>
        <h2 class="mt-3 text-3xl font-semibold text-white">{h.kitTitle}</h2>
        <p class="mt-3 text-slate-300 max-w-2xl leading-relaxed">{h.kitLead}</p>
        <p class="mt-3 text-sm text-slate-400 max-w-2xl leading-relaxed">{h.bridgeLead}</p>
        <a href={localePath(locale, full ? 'solutions/eu-launch-kit/' : 'contact/')} class="mt-7 btn-primary">{h.kitTitle}<Icon name="arrow" class="w-4 h-4" /></a>
      </div>
      <BridgeLine left={locale === 'zh' ? '上海 Shanghai' : 'Shanghai'} right={locale === 'zh' ? '慕尼黑 München' : 'München'} rightSub="UTC+1 / +2" />
    </div>
  </div>
</section>

{full && (
<section class="mx-auto max-w-7xl px-5 py-20">
  <SectionHead kicker="03 · Cases" title={h.casesTitle} />
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {cases.map((c) => (
      <a href={localePath(locale, `cases/${c.slug}/`)} class="card p-7 flex flex-col min-w-0 transition-colors group">
        <div class="flex gap-2">{c.tags.map((tg) => <span class="chip !text-[11px]">{tg}</span>)}</div>
        <h3 class="mt-4 text-lg font-semibold text-white leading-snug">{L(c.title)}</h3>
        <p class="mt-3 text-sm text-slate-400 leading-relaxed">{L(c.summary)}</p>
        <p class="mt-auto pt-5 font-mono-ui text-[11px] text-slate-500 truncate">{c.stack.join(' · ')}</p>
      </a>
    ))}
  </div>
</section>
)}

<section class:list={['mx-auto max-w-7xl px-5', full ? 'pb-20' : 'py-20']}>
  <SectionHead kicker={`${full ? '04' : '03'} · Process`} title={h.processTitle} />
  <ol class="mt-10 grid gap-6 md:grid-cols-4">
    {h.process.map((p, i) => (
      <li class="relative card p-6">
        <span class="font-[family-name:var(--font-display)] text-4xl font-semibold text-gradient">0{i + 1}</span>
        <h3 class="mt-3 text-lg font-semibold text-white">{p.t}</h3>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">{p.d}</p>
      </li>
    ))}
  </ol>
  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {e.items.map((x) => (
      <div class="rounded-xl border border-[var(--color-line)] p-5 flex gap-4">
        <Icon name={x.icon} class="w-6 h-6 shrink-0 text-violet-300" />
        <div><p class="text-white font-medium">{x.t}</p><p class="mt-1 text-sm text-slate-400 leading-relaxed">{x.d}</p></div>
      </div>
    ))}
  </div>
</section>

<section class="relative border-y border-white/5 bg-[#0b1220]/60">
  <div class="mx-auto max-w-7xl px-5 py-20 grid gap-12 lg:grid-cols-[1fr_1.4fr] items-start">
    <SectionHead kicker={`${full ? '05' : '04'} · ${h.stdKicker}`} title={h.stdTitle} lead={h.stdLead} />
    <dl class="grid gap-4 grid-cols-2 md:grid-cols-3">
      {h.std.map((m) => (
        <div class="card p-5">
          <dt class="font-mono-ui text-[11px] uppercase tracking-widest text-slate-400">{m.t}</dt>
          <dd class="mt-2 font-[family-name:var(--font-display)] text-2xl md:text-3xl font-semibold text-gradient">{m.v}</dd>
          <dd class="mt-2 text-xs text-slate-400 leading-relaxed">{m.d}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{full && (
<section class="mx-auto max-w-7xl px-5 py-20">
  <div class="flex items-end justify-between gap-6">
    <SectionHead kicker="06 · Labs" title={h.labsTitle} lead={h.labsLead} />
    <a href={localePath(locale, 'labs/')} class="hidden sm:inline-flex text-sm text-cyan-300 items-center gap-1 shrink-0">{h.labsTitle}<span class="sr-only"> overview</span><Icon name="arrow" class="w-4 h-4" /></a>
  </div>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {labs.map((l) => (
      <a href={localePath(locale, `labs/${l.slug}/`)} class="card card-glow p-7 flex gap-5 items-start transition-colors">
        <span class="shrink-0 inline-grid place-items-center w-11 h-11 rounded-xl bg-violet-500/15 text-violet-200"><Icon name="lab" /></span>
        <span>
          <span class="block text-lg font-semibold text-white">{L(l.title)}</span>
          <span class="block mt-2 text-sm text-slate-400">{L(l.summary)}</span>
          <span class="mt-4 flex flex-wrap gap-1.5">{l.stack.slice(0, 5).map((x) => <span class="chip !text-[11px]">{x}</span>)}</span>
        </span>
      </a>
    ))}
  </div>
</section>
)}

<section class:list={['mx-auto max-w-7xl px-5', !full && 'pt-20']}>
  <p class="kicker text-center">{h.stackTitle}</p>
  <div class="mt-8 grid gap-4 md:grid-cols-3">
    {stackLayers[locale].map((g) => (
      <div class="rounded-xl border border-[var(--color-line)] p-5">
        <p class="text-sm font-medium text-white">{g.t}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5 font-[family-name:var(--font-display)]">{g.items.map((x) => <li class="chip">{x}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<section class="mx-auto max-w-4xl px-5 pt-24 text-center">
  <h2 class="text-3xl md:text-4xl font-semibold text-white">{t.cta}</h2>
  <p class="mt-4 text-slate-400">{L({ zh: '告诉我们您的目标，1 个工作日内回复。', en: 'Tell us your goal; we reply within one business day.', de: 'Schildern Sie uns Ihr Ziel – Antwort innerhalb eines Werktags.' })}</p>
  <a href={localePath(locale, 'contact/')} class="mt-8 btn-primary">{t.ctaShort}<Icon name="arrow" class="w-4 h-4" /></a>
</section>

<script>
  import { initHero } from '../scripts/hero';
  const c = document.getElementById('hero-net') as HTMLCanvasElement | null;
  if (c) initHero(c);
</script>
