---
import Icon from '../components/Icon.astro';
import PageHead from './PageHead.astro';
import CtaBand from './CtaBand.astro';
import type { Service } from '../content/site';
import type { Locale } from '../i18n/ui';
interface Props { locale: Locale; service: Service }
const { locale, service: s } = Astro.props;
const L = (o: any) => o[locale] ?? o.en;
const T = { zh: { k: '服务', p: '常见挑战', d: '交付内容', st: '常用技术', f: '常见问题' }, en: { k: 'Service', p: 'Typical challenges', d: 'What we deliver', st: 'Typical stack', f: 'FAQ' } }[locale as 'zh' | 'en'];
const faq = L(s.faq) as { q: string; a: string }[];
---
<PageHead kicker={T.k} title={L(s.title)} lead={L(s.short)} />
<section class="mx-auto max-w-7xl px-5 py-16 grid gap-8 md:grid-cols-2">
  <div class="card p-8">
    <h2 class="text-xl font-semibold text-white">{T.p}</h2>
    <ul class="mt-5 space-y-3 text-slate-300">{L(s.pains).map((p: string) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>{p}</li>)}</ul>
  </div>
  <div class="card p-8">
    <h2 class="text-xl font-semibold text-white">{T.d}</h2>
    <ul class="mt-5 space-y-3 text-slate-300">{L(s.deliverables).map((p: string) => <li class="flex gap-3"><Icon name="check" class="w-5 h-5 shrink-0 text-cyan-300" />{p}</li>)}</ul>
  </div>
</section>
<section class="mx-auto max-w-7xl px-5">
  <h2 class="text-xl font-semibold text-white">{T.st}</h2>
  <ul class="mt-4 flex flex-wrap gap-2">{s.stack.map((x) => <li class="text-sm rounded-full border border-slate-600 px-3 py-1 text-slate-300">{x}</li>)}</ul>
</section>
<section class="mx-auto max-w-4xl px-5 py-16">
  <h2 class="text-2xl font-semibold text-white">{T.f}</h2>
  <div class="mt-6 divide-y divide-white/10 card">
    {faq.map((f) => <details class="p-6 group"><summary class="cursor-pointer text-white font-medium">{f.q}</summary><p class="mt-3 text-slate-300 leading-relaxed">{f.a}</p></details>)}
  </div>
</section>
<CtaBand locale={locale} />
