---
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import BridgeLine from '../components/BridgeLine.astro';
import PageHead from './PageHead.astro';
import CtaBand from './CtaBand.astro';
import Logo from '../components/Logo.astro';
import { about } from '../content/site';
import { company, type Locale } from '../i18n/ui';
interface Props { locale: 'zh' | 'en' }
const { locale } = Astro.props;
const a = about[locale];
---
<PageHead kicker="About" title={a.title} lead={a.lead} />
<section class="mx-auto max-w-6xl px-5 py-16 grid gap-12 md:grid-cols-[1.4fr_1fr] items-center">
  <div class="prose-s">
    {a.story.map((p) => <p>{p}</p>)}
    <p class="mt-8 text-2xl text-gradient font-semibold">{a.mission}</p>
  </div>
  <div class="card p-6 grid-bg">
    <BridgeLine left={locale === 'zh' ? '上海 Shanghai' : 'Shanghai'} right={locale === 'zh' ? '慕尼黑 München' : 'München'} rightSub="UTC+1 / +2" />
  </div>
</section>

<section class="mx-auto max-w-6xl px-5">
  <SectionHead kicker="Principles" title={a.valuesTitle} />
  <div class="mt-8 grid gap-4 md:grid-cols-3">
    {a.values.map((v, i) => (
      <div class="card card-glow p-7">
        <span class="font-mono-ui text-xs text-slate-500">0{i + 1}</span>
        <p class="mt-3 text-xl font-semibold text-gradient">{v.t}</p>
        <p class="mt-3 text-sm text-slate-300 leading-relaxed">{v.d}</p>
      </div>
    ))}
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 pt-16">
  <SectionHead kicker="How we work" title={a.workTitle} />
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {a.work.map((w) => (
      <div class="rounded-xl border border-[var(--color-line)] p-6">
        <Icon name={w.icon as any} class="w-6 h-6 text-cyan-300" />
        <p class="mt-4 text-white font-medium">{w.t}</p>
        <p class="mt-2 text-sm text-slate-400 leading-relaxed">{w.d}</p>
      </div>
    ))}
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 pt-16">
  <h2 class="text-2xl font-semibold text-white">{a.teamTitle}</h2>
  <div class="mt-6 card p-7 flex gap-6 items-start">
    <div class="shrink-0 w-16 h-16 rounded-2xl bg-gradient-to-br from-cyan-400/30 to-violet-500/30 grid place-items-center text-2xl font-semibold text-white">W</div>
    <div><p class="text-lg font-semibold text-white">{locale === 'zh' ? '王先生' : 'Mr. Wang'}</p><p class="text-sm text-cyan-300">{a.founderRole}</p><p class="mt-3 text-slate-300 leading-relaxed">{a.founderBio}</p></div>
  </div>
  <p class="mt-4 text-slate-400">{a.network}</p>
</section>
<section class="mx-auto max-w-6xl px-5 pt-16">
  <h2 class="text-2xl font-semibold text-white">{a.groupTitle}</h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    <div class="card p-6"><Logo size={28} zh animate={false} /><p class="mt-3 text-sm text-slate-400">{locale === 'zh' ? '技术实施' : 'Technology'}</p></div>
    {company.sisterSites.map((s) => <a href={s.url} rel="noopener" class="card p-6 block"><p class="text-white font-semibold">{s.name}</p><p class="mt-3 text-sm text-slate-400">{s.url.includes('weiyiliuxue') ? (locale === 'zh' ? '留学服务' : 'Study abroad') : (locale === 'zh' ? '商务咨询' : 'Business consulting')}</p></a>)}
  </div>
</section>
<CtaBand locale={locale as Locale} />
