---
import Icon from '../components/Icon.astro';
import PageHead from './PageHead.astro';
import CtaBand from './CtaBand.astro';
import SectionHead from '../components/SectionHead.astro';
import { services, engagement } from '../content/site';
import { localePath, ui, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const L = (o: any) => o[locale] ?? o.en;
const T = { zh: { k: '服务', t: '三项核心服务，一个团队交付', l: '从欧洲客户看到的官网，到支撑决策的数据平台，再到合规可靠的云架构。' },
  en: { k: 'Services', t: 'Three core services, one team', l: 'From the website European buyers see, to the data platform behind your decisions, to compliant and reliable cloud architecture.' },
  de: { k: 'Leistungen', t: 'Drei Kernleistungen aus einer Hand', l: 'Von der Website, die europäische Kunden sehen, über die Datenplattform für Ihre Entscheidungen bis zur konformen, zuverlässigen Cloud.' } }[locale];
const full = locale !== 'de';
const e = engagement[locale];
---
<PageHead kicker={T.k} title={T.t} lead={T.l} />
<section class="mx-auto max-w-7xl px-5 py-16 grid gap-6">
  {services.map((s) => (
    <article class="card p-8 grid md:grid-cols-[auto_1fr_auto] gap-6 items-start">
      <span class="inline-grid place-items-center w-14 h-14 rounded-xl bg-gradient-to-br from-cyan-400/20 to-violet-500/20 text-cyan-200"><Icon name={s.icon} class="w-7 h-7" /></span>
      <div>
        <h2 class="text-2xl font-semibold text-white">{L(s.title)}</h2>
        <p class="mt-3 text-slate-300 leading-relaxed max-w-3xl">{L(s.short)}</p>
        {full && <ul class="mt-4 grid gap-2 sm:grid-cols-2 text-sm text-slate-400">{L(s.deliverables).slice(0, 4).map((d: string) => <li class="flex gap-2"><Icon name="check" class="w-4 h-4 mt-0.5 shrink-0 text-cyan-300" />{d}</li>)}</ul>}
        <ul class="mt-4 flex flex-wrap gap-2">{s.stack.map((x) => <li class="chip">{x}</li>)}</ul>
      </div>
      <a href={localePath(locale, full ? `services/${s.slug}/` : 'contact/')} class="btn-ghost text-sm">{ui[locale].learnMore}<Icon name="arrow" class="w-4 h-4" /></a>
    </article>
  ))}
</section>
<section class="mx-auto max-w-7xl px-5">
  <SectionHead kicker={e.kicker} title={e.title} lead={e.lead} />
  <div class="mt-8 grid gap-4 md:grid-cols-3">
    {e.items.map((x, i) => (
      <div class="card card-glow p-6">
        <div class="flex items-center justify-between"><Icon name={x.icon} class="w-6 h-6 text-violet-300" /><span class="font-mono-ui text-xs text-slate-500">0{i + 1}</span></div>
        <p class="mt-4 text-lg font-semibold text-white">{x.t}</p>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed">{x.d}</p>
        <p class="mt-4 text-xs text-slate-400">{x.fit}</p>
      </div>
    ))}
  </div>
</section>
<CtaBand locale={locale} />
