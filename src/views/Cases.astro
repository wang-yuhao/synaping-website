---
import PageHead from './PageHead.astro';
import CtaBand from './CtaBand.astro';
import { cases } from '../content/site';
import { localePath, type Locale } from '../i18n/ui';
interface Props { locale: 'zh' | 'en' }
const { locale } = Astro.props;
const T = { zh: { k: '案例', t: '我们做过的项目', l: '以下项目均由团队独立完成或主导交付。' }, en: { k: 'Cases', t: 'Work we have delivered', l: 'Projects our team built or led end to end.' } }[locale];
---
<PageHead kicker={T.k} title={T.t} lead={T.l} />
<section class="mx-auto max-w-7xl px-5 py-16 grid gap-6 md:grid-cols-3">
  {cases.map((c) => (
    <a href={localePath(locale, `cases/${c.slug}/`)} class="card card-glow p-7 flex flex-col transition-colors">
      <div class="flex gap-2">{c.tags.map((tg) => <span class="chip !text-[11px]">{tg}</span>)}</div>
      <h2 class="mt-4 text-lg font-semibold text-white">{c.title[locale]}</h2>
      <p class="mt-3 text-sm text-slate-400 leading-relaxed">{c.summary[locale]}</p>
      <p class="mt-auto pt-5 font-mono-ui text-[11px] text-slate-400">{c.stack.join(' · ')}</p>
    </a>
  ))}
</section>
<CtaBand locale={locale as Locale} />
