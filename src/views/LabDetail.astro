---
import ArchDiagram from '../components/ArchDiagram.astro';
import SectionHead from '../components/SectionHead.astro';
import PageHead from './PageHead.astro';
import CtaBand from './CtaBand.astro';
import type { Lab } from '../content/site';
interface Props { locale: 'zh' | 'en'; item: Lab }
const { locale, item: l } = Astro.props;
const labels = {
  zh: { train: '训练窗口', test: '样本外测试窗口', cap: '模拟数据示意：4 个滚动 walk-forward 分段', ar: '系统架构', hi: '工程亮点', st: '技术栈', refs: '公开数据与文献' },
  en: { train: 'Training window', test: 'Out-of-sample window', cap: 'Synthetic data: 4 rolling walk-forward folds', ar: 'System architecture', hi: 'Engineering highlights', st: 'Stack', refs: 'Public data and literature' },
}[locale];
---
<PageHead kicker={l.tags.join(' · ')} title={l.title[locale]} lead={l.summary[locale]} />
<section class="mx-auto max-w-5xl px-5 py-16">
  {l.disclaimer && <p class="mb-8 rounded-xl border border-amber-400/40 bg-amber-400/5 px-5 py-4 text-sm text-amber-200">{l.disclaimer[locale]}</p>}
  <div class="grid gap-10 md:grid-cols-[1.6fr_1fr]">
    <div class="prose-s !mt-0">{l.body[locale].map((p) => <p>{p}</p>)}</div>
    <aside class="space-y-6">
      <div class="card p-6">
        <h2 class="text-sm font-medium text-slate-300">{labels.st}</h2>
        <ul class="mt-3 flex flex-wrap gap-2">{l.stack.map((x) => <li class="chip">{x}</li>)}</ul>
      </div>
      {l.refs && (
        <div class="card p-6">
          <h2 class="text-sm font-medium text-slate-300">{labels.refs}</h2>
          <ul class="mt-3 space-y-2 text-sm">{l.refs.map((r) => <li><a href={r.url} rel="noopener" class="text-cyan-300 hover:text-cyan-200 underline underline-offset-4">{r.label}</a></li>)}</ul>
        </div>
      )}
    </aside>
  </div>
  {l.demo && (
    <figure class="mt-10 card p-4">
      <canvas id="quant-demo" class="w-full h-80" data-train={labels.train} data-test={labels.test} role="img" aria-label={labels.cap}></canvas>
      <figcaption class="mt-2 text-xs text-slate-400 px-2">{labels.cap}</figcaption>
    </figure>
  )}
</section>
<section class="mx-auto max-w-5xl px-5">
  <SectionHead kicker="Architecture" title={labels.ar} />
  <div class="mt-8"><ArchDiagram cols={l.arch[locale]} /></div>
</section>
<section class="mx-auto max-w-5xl px-5 pt-16">
  <SectionHead kicker="Highlights" title={labels.hi} />
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {l.highlights[locale].map((h, i) => (
      <div class="card p-6">
        <span class="font-mono-ui text-xs text-cyan-300">{String(i + 1).padStart(2, '0')}</span>
        <p class="mt-2 text-white font-semibold">{h.t}</p>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed">{h.d}</p>
      </div>
    ))}
  </div>
</section>
<CtaBand locale={locale} />
<script>
  import { initQuantDemo } from '../scripts/quant-demo';
  const c = document.getElementById('quant-demo') as HTMLCanvasElement | null;
  if (c) initQuantDemo(c, { train: c.dataset.train!, test: c.dataset.test! });
</script>
