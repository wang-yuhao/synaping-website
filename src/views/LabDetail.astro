---
import PageHead from './PageHead.astro';
import type { Lab } from '../content/site';
interface Props { locale: 'zh' | 'en'; item: Lab }
const { locale, item: l } = Astro.props;
const labels = { zh: { train: '训练窗口', test: '样本外测试窗口', cap: '模拟数据示意：4 个滚动 walk-forward 分段' }, en: { train: 'Training window', test: 'Out-of-sample window', cap: 'Synthetic data: 4 rolling walk-forward folds' } }[locale];
---
<PageHead kicker={l.tags.join(' · ')} title={l.title[locale]} lead={l.summary[locale]} />
<section class="mx-auto max-w-4xl px-5 py-16">
  {l.disclaimer && <p class="mb-8 rounded-xl border border-amber-400/40 bg-amber-400/5 px-5 py-4 text-sm text-amber-200">{l.disclaimer[locale]}</p>}
  <div class="prose-s">{l.body[locale].map((p) => <p>{p}</p>)}</div>
  {l.demo && (
    <figure class="mt-10 card p-4">
      <canvas id="quant-demo" class="w-full h-80" data-train={labels.train} data-test={labels.test} role="img" aria-label={labels.cap}></canvas>
      <figcaption class="mt-2 text-xs text-slate-400 px-2">{labels.cap}</figcaption>
    </figure>
  )}
</section>
<script>
  import { initQuantDemo } from '../scripts/quant-demo';
  const c = document.getElementById('quant-demo') as HTMLCanvasElement | null;
  if (c) initQuantDemo(c, { train: c.dataset.train!, test: c.dataset.test! });
</script>
