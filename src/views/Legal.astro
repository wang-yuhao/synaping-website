---
import PageHead from './PageHead.astro';
import { legalDraftNote, privacy, notice } from '../content/legal';
import type { Locale } from '../i18n/ui';
interface Props { locale: Locale; kind: 'privacy' | 'notice' }
const { locale, kind } = Astro.props;
const doc = (kind === 'privacy' ? privacy : notice)[locale];
---
<PageHead title={doc.title} />
<section class="mx-auto max-w-3xl px-5 py-12">
  <p class="mb-6 rounded-lg border border-amber-400/40 bg-amber-400/5 px-4 py-3 text-sm text-amber-200">{legalDraftNote[locale]}</p>
  <div class="prose-s" set:html={doc.html} />
</section>
