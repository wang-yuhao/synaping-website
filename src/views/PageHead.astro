---
interface Props { kicker?: string; title: string; lead?: string }
const { kicker, title, lead } = Astro.props;
---
<section class="relative overflow-hidden glow border-b border-white/5">
  <div class="absolute inset-0 grid-bg [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-5 py-16 md:py-20">
    {kicker && <p class="text-xs tracking-[0.3em] uppercase text-cyan-300">{kicker}</p>}
    <h1 class="mt-3 text-3xl md:text-5xl font-semibold text-white max-w-4xl leading-tight">{title}</h1>
    {lead && <p class="mt-5 text-lg text-slate-300 max-w-3xl leading-relaxed">{lead}</p>}
  </div>
</section>
