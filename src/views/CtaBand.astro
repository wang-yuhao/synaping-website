---
import Icon from '../components/Icon.astro';
import { localePath, ui, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="mx-auto max-w-7xl px-5 pt-16">
  <div class="card p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <p class="text-xl text-white font-semibold">{ui[locale].cta}</p>
    <a href={localePath(locale, 'contact/')} class="btn-primary">{ui[locale].ctaShort}<Icon name="arrow" class="w-4 h-4" /></a>
  </div>
</section>
