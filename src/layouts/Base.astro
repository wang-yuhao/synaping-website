---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company, htmlLang, localePath, ui, type Locale } from '../i18n/ui';

interface Props { locale: Locale; slug: string; title: string; description: string; alternates: Locale[]; jsonLd?: object; noindex?: boolean }
const { locale, slug, title, description, alternates, jsonLd, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(localePath(locale, slug), site).href;
const og = new URL('/og-image.jpg', site).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: `${company.brandZh} ${company.brand}`,
  legalName: company.legalNameZh, url: site.href, email: company.email, logo: new URL('/logo.svg', site).href,
  address: [{ '@type': 'PostalAddress', addressCountry: 'CN', addressLocality: 'Shanghai' }, { '@type': 'PostalAddress', addressCountry: 'DE', addressLocality: 'München' }],
};
---
<!doctype html>
<html lang={htmlLang[locale]} class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="renderer" content="webkit" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {locale === 'zh' && <meta name="keywords" content="出海,欧洲市场,企业官网,数据平台,Databricks,GDPR,个人信息保护法,云架构,中欧,惟意科技" />}
  <link rel="canonical" href={canonical} />
  {alternates.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(localePath(l, slug), site).href} />)}
  {alternates.includes('zh') && <link rel="alternate" hreflang="x-default" href={new URL(localePath('zh', slug), site).href} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:locale" content={htmlLang[locale].replace('-', '_')} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#070b16" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="Synaping Insights" href="/rss.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd ? [org, jsonLd] : org)} />
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white text-black px-3 py-2 rounded z-50">{ui[locale].skip}</a>
  <Header locale={locale} slug={slug} alternates={alternates} />
  <main id="main" class="flex-1"><slot /></main>
  <Footer locale={locale} />
</body>
</html>
