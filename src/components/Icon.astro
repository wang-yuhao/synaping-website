---
interface Props { name: 'web' | 'data' | 'cloud' | 'arrow' | 'lab' | 'check'; class?: string }
const { name, class: cls = 'w-6 h-6' } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'web' && <><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M3 8h18M7 21h10M8 12h5M8 15h8" /></>}
  {name === 'data' && <><ellipse cx="12" cy="5.5" rx="7" ry="2.5" /><path d="M5 5.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6M5 11.5v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6" /></>}
  {name === 'cloud' && <><path d="M7 18h10a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.1 9.5 4.3 4.3 0 0 0 7 18z" /><path d="M12 11v5M10 14l2 2 2-2" /></>}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'lab' && <><path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-5-9V3" /><path d="M7.5 15h9" /></>}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
</svg>
