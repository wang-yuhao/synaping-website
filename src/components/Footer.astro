---
import Logo from './Logo.astro';
import { company, localePath, ui, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const year = 2026;
---
<footer class="border-t border-white/5 mt-24">
  <div class="mx-auto max-w-7xl px-5 py-12 grid gap-10 md:grid-cols-4 text-sm">
    <div class="md:col-span-2 space-y-3">
      <Logo size={32} zh animate={false} />
      <p class="text-slate-400">{t.footerTagline}</p>
      <p class="text-slate-500">{company.legalNameZh}{locale !== 'zh' && <><br />{company.legalNameEn}</>}</p>
      <p class="text-slate-500"><a href={`mailto:${company.email}`} class="hover:text-white">{company.email}</a></p>
    </div>
    <div>
      <p class="text-slate-300 font-medium mb-3">{t.footerGroup}</p>
      <ul class="space-y-2 text-slate-400">
        {company.sisterSites.map((s) => <li><a href={s.url} class="hover:text-white" rel="noopener">{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="text-slate-300 font-medium mb-3">{t.footerLegal}</p>
      <ul class="space-y-2 text-slate-400">
        <li><a href={localePath(locale, 'legal/privacy/')} class="hover:text-white">{t.privacy}</a></li>
        <li><a href={localePath(locale, 'legal/notice/')} class="hover:text-white">{t.notice}</a></li>
        <li><a href={localePath(locale, 'contact/')} class="hover:text-white">{t.nav.contact}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/5">
    <div class="mx-auto max-w-7xl px-5 py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-slate-500">
      <span>© {year} {company.brandZh} Synaping · {t.rights}</span>
      <span class="flex gap-4">
        <a href={company.icpUrl} target="_blank" rel="noopener" class="hover:text-slate-300">{company.icp}</a>
        <!-- 公安联网备案号：备案通过后在此添加（见 docs/content-facts.md） -->
      </span>
    </div>
  </div>
</footer>
