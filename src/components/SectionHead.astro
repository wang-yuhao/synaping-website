---
interface Props { kicker?: string; title: string; lead?: string; center?: boolean; as?: 'h2' | 'h3' }
const { kicker, title, lead, center = false, as: Tag = 'h2' } = Astro.props;
---
<div class:list={[center && 'text-center mx-auto', 'max-w-3xl']}>
  {kicker && <p class="kicker">{kicker}</p>}
  <Tag class="mt-3 text-3xl md:text-4xl font-semibold text-white leading-tight">{title}</Tag>
  {lead && <p class="mt-4 text-slate-300 leading-relaxed">{lead}</p>}
</div>
