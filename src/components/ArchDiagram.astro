---
// Data-driven architecture diagram: columns of components joined by animated connectors.
// HTML rather than SVG so CJK labels wrap naturally and the layout stacks on mobile.
export interface ArchCol { t: string; items: string[]; tone?: 'cyan' | 'violet' | 'amber' }
interface Props { cols: ArchCol[]; caption?: string }
const { cols, caption } = Astro.props;
const text = { cyan: 'text-cyan-300', violet: 'text-violet-300', amber: 'text-amber-300' };
const border = { cyan: 'border-cyan-400/30', violet: 'border-violet-400/30', amber: 'border-amber-400/30' };
---
<figure class="card p-5 md:p-7 grid-bg">
  <div class="flex flex-col md:flex-row items-stretch gap-0">
    {cols.map((c, i) => (
      <>
        {i > 0 && (
          <div class="flex md:flex-col items-center justify-center shrink-0 h-8 md:h-auto md:w-10" aria-hidden="true">
            <span class="block md:hidden w-px h-full flow-y"></span>
            <span class="hidden md:block w-full h-px flow-x"></span>
          </div>
        )}
        <div class:list={['flex-1 min-w-0 rounded-xl border bg-[#0b1220]/90 p-4', border[c.tone ?? 'cyan']]}>
          <p class:list={['font-mono-ui text-[11px] tracking-widest uppercase', text[c.tone ?? 'cyan']]}>{String(i + 1).padStart(2, '0')} · {c.t}</p>
          <ul class="mt-3 space-y-1.5 text-sm text-slate-200">
            {c.items.map((x) => <li class="flex gap-2"><span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-slate-400"></span><span>{x}</span></li>)}
          </ul>
        </div>
      </>
    ))}
  </div>
  {caption && <figcaption class="mt-4 text-xs text-slate-400">{caption}</figcaption>}
</figure>
